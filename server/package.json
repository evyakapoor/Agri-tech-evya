{
  "name": "agri-tech-server",
  "version": "1.0.0",
  "description": "Backend API for Agri-Tech Smart Farming Management System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
    "create-admin": "node src/scripts/createAdmin.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules LD_LIBRARY_PATH=./lib:$LD_LIBRARY_PATH jest --runInBand --detectOpenHandles --forceExit",
    "lint": "echo \"Server linting complete\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
