# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or configurable URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agritech?retryWrites=true&w=majority

# Authentication Secrets
JWT_SECRET=replace_with_a_long_random_secure_jwt_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL in development/production)
CLIENT_URL=http://localhost:5173

# Frontend API Base URL (used during Vite build or client requests)
VITE_API_BASE_URL=http://localhost:5000/api

# External Weather Provider (OpenWeatherMap API Key)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=150
